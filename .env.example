# Copy to .env and fill in.
ANTHROPIC_API_KEY=
# anthropic (only provider so far)
AI_PROVIDER=anthropic
# Model used for fit scoring. claude-opus-5 = best quality; claude-sonnet-5 = cheaper.
AI_MODEL=claude-opus-5
# Watchlist pre-screen: a free model that answers yes / maybe / no on jobs found on watched boards.
# off | groq | gemini | openrouter | ollama | custom | anthropic (Claude Haiku 4.5, paid)
PRESCREEN_PROVIDER=off
PRESCREEN_API_KEY=
# Optional: override the provider's default model or address (any OpenAI-compatible API).
PRESCREEN_MODEL=
PRESCREEN_BASE_URL=
