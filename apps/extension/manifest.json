{
  "manifest_version": 3,
  "name": "Job Matrix",
  "description": "See what Job Matrix knows about the job or company on the page, add new postings to Screening, and draft application answers.",
  "version": "0.7.2",
  "key": "",
  "icons": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" },
  "action": { "default_title": "Job Matrix" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "nativeMessaging", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*"] }
}
